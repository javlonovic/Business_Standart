# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/business_standart
DATABASE_POOL_MIN_SIZE=10
DATABASE_POOL_MAX_SIZE=50

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# S3 Storage
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BUCKET_NAME=business-standart-docs
S3_REGION=us-east-1

# Payment Systems
PAYME_MERCHANT_ID=your-payme-merchant-id
PAYME_SECRET_KEY=your-payme-secret-key
CLICK_MERCHANT_ID=your-click-merchant-id
CLICK_SECRET_KEY=your-click-secret-key

# SMS Gateway
SMS_GATEWAY_URL=https://api.playmobile.uz
SMS_GATEWAY_TOKEN=your-sms-token

# Email
SMTP_HOST=smtp.mail.ru
SMTP_PORT=587
SMTP_USER=business_standart@mail.ru
SMTP_PASSWORD=your-email-password

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Application
DEBUG=true
LOG_LEVEL=INFO
