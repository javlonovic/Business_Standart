# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/business_standart
DATABASE_POOL_MIN_SIZE=10
DATABASE_POOL_MAX_SIZE=50

# Redis
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=dev-secret-key-change-in-production-12345678901234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# S3 Storage (placeholder values for local testing)
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_ACCESS_KEY=dev-placeholder-access-key
S3_SECRET_KEY=dev-placeholder-secret-key
S3_BUCKET_NAME=business-standart-docs-dev
S3_REGION=us-east-1

# Payment Systems (placeholder values for local testing)
PAYME_MERCHANT_ID=dev-payme-merchant-id
PAYME_SECRET_KEY=dev-payme-secret-key
CLICK_MERCHANT_ID=dev-click-merchant-id
CLICK_SECRET_KEY=dev-click-secret-key

# SMS Gateway (placeholder values for local testing)
SMS_GATEWAY_URL=https://api.playmobile.uz
SMS_GATEWAY_TOKEN=dev-sms-token-placeholder

# Email (placeholder values for local testing)
SMTP_HOST=smtp.mail.ru
SMTP_PORT=587
SMTP_USER=business_standart@mail.ru
SMTP_PASSWORD=dev-email-password-placeholder

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Application
DEBUG=true
LOG_LEVEL=INFO
